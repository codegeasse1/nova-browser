{
  "manifest_version": 2,
  "name": "Night Shift",
  "version": "1.0.0",
  "description": "Dark mode for every website. Inverts page colors while keeping images and video natural.",
  "permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nightshift@nova.browser"
    }
  }
}
