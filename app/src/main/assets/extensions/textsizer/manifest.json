{
  "manifest_version": 2,
  "name": "Text Sizer",
  "version": "1.0.0",
  "description": "Enlarges page text to 112% for easier reading.",
  "permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "textsizer@nova.browser"
    }
  }
}
