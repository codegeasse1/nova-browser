{
  "manifest_version": 2,
  "name": "Block Images",
  "version": "1.0.0",
  "description": "Hides all images and videos on every site for fast, data-light browsing.",
  "permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "imageblocker@nova.browser"
    }
  }
}
